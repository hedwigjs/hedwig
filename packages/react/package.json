{
  "name": "@hedwigjs/react",
  "version": "0.1.0",
  "description": "React hooks for Hedwig: clients, topics, retained state, requests and remote clients bound to the component lifecycle.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedwigjs/hedwig.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/hedwigjs/hedwig/issues"
  },
  "homepage": "https://github.com/hedwigjs/hedwig/tree/main/packages/react#readme",
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hedwigjs/client": "^0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "keywords": ["hedwig", "react", "hooks", "message-broker", "microfrontend"],
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18.17.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": ["**/src/**/*.test.ts", "**/src/**/*.test.tsx"]
  }
}
