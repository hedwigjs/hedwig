{
  "name": "@hedwigjs/devtools",
  "version": "0.1.0",
  "description": "DevTools panel for @hedwigjs/broker — message flow, clients, and observability inspector.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hedwigjs/hedwig.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/hedwigjs/hedwig/issues"
  },
  "homepage": "https://github.com/hedwigjs/hedwig/tree/main/packages/devtools#readme",
  "scripts": {
    "build": "webpack --config webpack.config.cjs && tsc -p tsconfig.dts.json",
    "watch": "webpack --config webpack.config.cjs --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hedwigjs/broker": "^0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@hedwigjs/broker": "*",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "css-loader": "^6.10.0",
    "jest": "^29.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "hedwig",
    "devtools",
    "message-broker",
    "microfrontends",
    "react",
    "observability"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ]
  }
}
