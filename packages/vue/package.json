{
  "name": "@hedwigjs/vue",
  "version": "0.1.0",
  "description": "Vue composables for Hedwig: clients, topics, retained state, requests and remote clients bound to the component scope.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedwigjs/hedwig.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/hedwigjs/hedwig/issues"
  },
  "homepage": "https://github.com/hedwigjs/hedwig/tree/main/packages/vue#readme",
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hedwigjs/client": "^0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.0"
  },
  "keywords": ["hedwig", "vue", "composables", "message-broker", "microfrontend"],
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18.17.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": ["**/src/**/*.test.ts"]
  }
}
