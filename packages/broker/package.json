{
  "name": "@hedwigjs/broker",
  "version": "0.2.0",
  "description": "Runtime broker for the Hedwig messaging toolkit. One API over any transport.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./spec/envelope-v1.schema.json": "./spec/envelope-v1.schema.json",
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.mjs",
      "require": "./dist/conformance/index.cjs",
      "default": "./dist/conformance/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedwigjs/hedwig.git",
    "directory": "packages/broker"
  },
  "bugs": {
    "url": "https://github.com/hedwigjs/hedwig/issues"
  },
  "homepage": "https://github.com/hedwigjs/hedwig/tree/main/packages/broker#readme",
  "scripts": {
    "build": "rm -rf dist && tsup",
    "watch": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "bench": "node benchmarks/run-all.mjs",
    "bench:one": "node benchmarks/run-one.mjs"
  },
  "dependencies": {
    "@hedwigjs/client": "^0.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/ws": "^8.5.12",
    "ajv": "^8.17.1",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "tinybench": "^6.1.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "ws": "^8.18.0"
  },
  "keywords": [
    "hedwig",
    "message-broker",
    "event-bus",
    "pubsub",
    "microfrontend",
    "type-safe",
    "typescript"
  ],
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
