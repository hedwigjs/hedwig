{
  "name": "@hedwigjs/client",
  "version": "0.1.0",
  "description": "SDK for modules that talk to a Hedwig runtime: createClient, createRemoteClient, and every type a module can see. No runtime dependency.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedwigjs/hedwig.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/hedwigjs/hedwig/issues"
  },
  "homepage": "https://github.com/hedwigjs/hedwig/tree/main/packages/client#readme",
  "scripts": {
    "build": "rm -rf dist && tsup",
    "watch": "tsup --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "hedwig",
    "message-broker",
    "microfrontend",
    "sdk",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
